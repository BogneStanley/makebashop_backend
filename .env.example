# Production compose configuration. Copy to .env and replace every value.
# Never commit the resulting .env file.
BACKEND_IMAGE=registry.example.com/makeba-shop/backend:<immutable-git-tag>@sha256:<verified-digest>
POSTGRES_IMAGE=postgres:<verified-version>@sha256:<verified-digest>
REDIS_IMAGE=redis:<verified-version>@sha256:<verified-digest>

DB_URL=jdbc:postgresql://postgres:5432/shop
DB_USERNAME=shop_app
DB_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=shop
POSTGRES_USER=shop_app
POSTGRES_PASSWORD=replace-with-the-same-long-random-database-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-redis-password
JWT_SECRET=replace-with-a-minimum-32-byte-random-secret
CORS_ALLOWED_ORIGINS=https://shop.example.com
PUBLIC_BASE_URL=https://api.shop.example.com
API_HOST=api.shop.example.com
